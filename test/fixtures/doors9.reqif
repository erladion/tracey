      <SPEC-OBJECTS>
        <!-- System requirements module -->
        <SPEC-OBJECT IDENTIFIER="o-h1" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-sys</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="Payments"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-chap</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="o-intro" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-sys</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="2"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>a-text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The payment gateway handles <xhtml:span style="font-weight:bold;">card</xhtml:span> and invoice payments &amp; refunds.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>st-acc</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-prio</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>p-high</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
          <ATTRIBUTE-VALUE-INTEGER THE-VALUE="3"><DEFINITION><ATTRIBUTE-DEFINITION-INTEGER-REF>a-effort</ATTRIBUTE-DEFINITION-INTEGER-REF></DEFINITION></ATTRIBUTE-VALUE-INTEGER>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="ana"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-cby</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="o-12" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-sys</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="12"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>a-text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div><xhtml:p>When the gateway times out, the system <xhtml:b>shall</xhtml:b> retry the payment.</xhtml:p><xhtml:ul><xhtml:li>at most 3 times</xhtml:li><xhtml:li>with <xhtml:i>increasing</xhtml:i> delay<xhtml:ul><xhtml:li>1 s, 4 s, 16 s</xhtml:li></xhtml:ul></xhtml:li></xhtml:ul></xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>st-acc</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-prio</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>p-high</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="o-h11" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-sys</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="3"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="Limits"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-chap</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="o-13" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-sys</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="13"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>a-text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div><xhtml:p>Daily limits per card type:</xhtml:p><xhtml:table border="1"><xhtml:tbody><xhtml:tr><xhtml:td><xhtml:b>Card</xhtml:b></xhtml:td><xhtml:td><xhtml:b>Limit</xhtml:b></xhtml:td></xhtml:tr><xhtml:tr><xhtml:td>Debit</xhtml:td><xhtml:td>5 000 | 10 000</xhtml:td></xhtml:tr><xhtml:tr><xhtml:td>Credit</xhtml:td><xhtml:td>20 000<xhtml:br/>(Pro: 50 000)</xhtml:td></xhtml:tr></xhtml:tbody></xhtml:table></xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>st-prop</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-variant</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>v-base</ENUM-VALUE-REF><ENUM-VALUE-REF>v-pro</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="o-14" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-sys</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="14"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>a-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>a-text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>The limit screen looks like this: <xhtml:object data="files/limits.ole" type="application/oleobject"><xhtml:object data="files/limits.png" type="image/png">Limits</xhtml:object></xhtml:object> and the old one: <xhtml:object data="files/legacy.ole" type="application/oleobject"/></xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>st-rej</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>a-variant</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>v-pro</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
        </VALUES></SPEC-OBJECT>
        <!-- System test module -->
        <SPEC-OBJECT IDENTIFIER="t-h1" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-test</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>b-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="Payment tests"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>b-chap</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="t-5" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-test</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="5"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>b-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>b-text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div><xhtml:p>Retry after a gateway timeout.</xhtml:p><xhtml:ol><xhtml:li>Make the gateway time out once.</xhtml:li><xhtml:li>Pay with a debit card.</xhtml:li></xhtml:ol><xhtml:p>Expected: the payment succeeds on the second attempt.</xhtml:p></xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>b-status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>st-acc</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
        </VALUES></SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="t-6" LAST-CHANGE="2026-09-01T10:00:00Z"><TYPE><SPEC-OBJECT-TYPE-REF>t-test</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
          <ATTRIBUTE-VALUE-STRING THE-VALUE="6"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>b-fid</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>b-text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>Check the daily limits for each card type.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
        </VALUES></SPEC-OBJECT>
